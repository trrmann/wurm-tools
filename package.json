{
  "name": "wurm-tools",
  "private": true,
  "version": "1.5.2",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "description": "A modular toolkit and dashboard for Wurm Online and Wurm Unlimited players",
  "engines": {
    "node": ">=24.22.1 <25",
    "pnpm": "12.15.0"
  },
  "scripts": {
    "predev": "pnpm run helper",
    "dev": "vite",
    "prepreview": "pnpm run helper",
    "helper": "node scripts/wurm-local.js",
    "helper:pair-code": "node scripts/wurm-local.js --pairing-code",
    "heroes:setup-code": "node scripts/wurm-local.js --heroes-setup-code",
    "helper:stop": "node scripts/wurm-local.js --stop",
    "helper:unpair": "node scripts/wurm-local.js --unpair-all",
    "helper:startup:install": "node scripts/helper-startup.js install",
    "helper:startup:remove": "node scripts/helper-startup.js remove",
    "helper:installer:build": "node scripts/build-helper-installer.js",
    "helper:installer:build:developer": "node scripts/build-helper-installer.js --developer",
    "helper:installer:test:developer": "node scripts/test-developer-installer.js",
    "helper:installer:test": "node scripts/test-helper-installer.js",
    "helper:installer:sign": "node scripts/sign-helper-installer.js sign",
    "helper:installer:verify": "node scripts/sign-helper-installer.js verify",
    "helper:installer:build:signed": "pnpm run helper:installer:build && pnpm run helper:installer:test && pnpm run helper:installer:sign && pnpm run helper:installer:verify",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:w3c": "node scripts/w3c-local.js",
    "test:w3c:setup": "node scripts/w3c-local.js --setup",
    "test:w3c:ready": "node scripts/w3c-local.js --check-tools",
    "test:w3c:html": "node scripts/w3c-local.js --html",
    "test:w3c:css": "node scripts/w3c-local.js --css",
    "test:lighthouse": "node scripts/test-lighthouse.js",
    "test:css-overview": "node scripts/test-css-overview.js",
    "test:memory": "node scripts/test-memory.js",
    "test:chrome": "node scripts/test-chrome.js",
    "test:standards": "node scripts/test-standards.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "version:major": "node scripts/version.js major",
    "version:minor": "node scripts/version.js minor",
    "version:patch": "node scripts/version.js patch",
    "storage:clear": "node scripts/clear-chrome-storage.js"
  },
  "devDependencies": {
    "@eslint/css": "^2.0.0",
    "@eslint/js": "^10.0.1",
    "@html-eslint/eslint-plugin": "^0.66.1",
    "@html-eslint/parser": "^0.66.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "vite": "^6.2.0",
    "vitest": "^4.1.11",
    "ws": "^8.22.0"
  },
  "dependencies": {
    "sql.js": "^1.14.2"
  }
}
